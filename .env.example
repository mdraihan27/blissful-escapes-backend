# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/blissful-escapes

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d

# Login link (magic link) settings
LOGIN_LINK_EXPIRES_MINUTES=15

# Frontend (used to build the login link AND as the allowed CORS origin)
FRONTEND_URL=http://localhost:3000

# Optional: additional allowed CORS origins (comma-separated), e.g. a
# staging frontend. FRONTEND_URL is always allowed and does not need to
# be repeated here.
# CORS_EXTRA_ORIGINS=https://staging.example.com,https://admin.example.com

# SMTP (for sending the login link email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dummy-smtp-user
SMTP_PASS=dummy-smtp-pass
SMTP_FROM="Blissful Escapes <no-reply@example.com>"

# Fixed recipient for the login link email
LOGIN_LINK_RECIPIENT_EMAIL=admin@example.com

# Seed user (used only by: npm run seed:user)
SEED_USER_ID=admin
SEED_USER_PASSWORD=ChangeMe123!
